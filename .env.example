# Tenant slug — must match "tenantSlug" in astropayload.config.json.
# Used to build the R2 media key: {R2_PUBLIC_URL}/tenants/{PUBLIC_TENANT_SLUG}/{filename}
PUBLIC_TENANT_SLUG=nerdplaza

# Public base URL of the shared Payload R2 bucket.
# Without this the media resolver falls back to the fleet default in
# src/lib/media-url.mjs, which is correct today but should be set explicitly in CI.
R2_PUBLIC_URL=https://pub-d4024ad3e57841448e0ee58a19abe46b.r2.dev
