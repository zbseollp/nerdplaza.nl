---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import Sidebar from '../components/Sidebar.astro';

interface Props {
  entry: CollectionEntry<'blog'>;
}

const { entry } = Astro.props;
const { title, description, pubDate, author, categories, featuredImage, imageAlt } = entry.data;

const formattedDate = pubDate.toLocaleDateString('nl-NL', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const postUrl = `/${entry.id}/`;
---

<BaseLayout title={title} description={description} canonical={new URL(postUrl, Astro.site).href}>
  <slot name="header" slot="header" />
  <article class="blog-detail section">
    <div class="container blog-detail-grid">
      <div class="blog-detail-main">
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <ol>
            <li><a href="/">Home</a></li>
            <li aria-hidden="true">/</li>
            <li><a href="/blog/">Blog</a></li>
            <li aria-hidden="true">/</li>
            <li aria-current="page">{title}</li>
          </ol>
        </nav>

        <header class="blog-detail-header">
          <h1>{title}</h1>
          <div class="blog-detail-meta">
            <time datetime={pubDate.toISOString()}>{formattedDate}</time>
            {author && <span class="blog-detail-author">door {author}</span>}
            {
              categories && categories.length > 0 && (
                <span class="blog-detail-categories">{categories.join(', ')}</span>
              )
            }
          </div>
        </header>

        {
          featuredImage && (
            <figure class="blog-detail-image">
              <img src={featuredImage} alt={imageAlt || title} width="960" height="540" loading="eager" decoding="async" />
            </figure>
          )
        }

        <div class="blog-detail-content prose">
          <slot />
        </div>

        <footer class="blog-detail-footer">
          <a href="/blog/" class="btn">← Terug naar blog</a>
        </footer>
      </div>

      <Sidebar currentSlug={entry.id} />
    </div>
  </article>
  <slot name="footer" slot="footer" />
</BaseLayout>

<style>
  .blog-detail-grid {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(260px, 1fr);
    gap: clamp(2rem, 4vw, 3.5rem);
    align-items: start;
  }

  @media (max-width: 960px) {
    .blog-detail-grid {
      grid-template-columns: 1fr;
    }
  }

  .breadcrumb ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }

  .breadcrumb a:hover {
    color: var(--color-accent);
  }

  .blog-detail-header {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-bottom: 2rem;
  }

  .blog-detail-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.25rem;
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }

  .blog-detail-image {
    margin: 0 0 2rem;
    border-radius: var(--radius-md);
    overflow: hidden;
    aspect-ratio: 16 / 10;
    background: var(--color-bg-dark);
  }

  .blog-detail-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .blog-detail-content :global(h2),
  .blog-detail-content :global(h3),
  .blog-detail-content :global(h4) {
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    color: var(--color-text);
  }

  .blog-detail-content :global(p) {
    margin-bottom: 1.25rem;
    color: var(--color-text-muted);
    font-size: 1.0625rem;
    line-height: 1.75;
  }

  .blog-detail-content :global(a) {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .blog-detail-content :global(a:hover) {
    color: var(--color-accent-hover);
  }

  .blog-detail-content :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: var(--radius-sm);
    margin: 1.5rem 0;
  }

  .blog-detail-content :global(ul),
  .blog-detail-content :global(ol) {
    margin-bottom: 1.25rem;
    padding-left: 1.5rem;
    color: var(--color-text-muted);
  }

  .blog-detail-content :global(li) {
    margin-bottom: 0.5rem;
    list-style: disc;
  }

  .blog-detail-footer {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border);
  }
</style>
