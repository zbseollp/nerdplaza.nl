---
/**
 * Payload / editors often open /blog/<slug>/. Canonical URLs are /<slug>/.
 * Without this redirect, newly published posts look "offline" at the blog path.
 */
import { getAllPosts } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getAllPosts();
  return posts.map((post) => ({
    params: { slug: post.id },
  }));
}

const { slug } = Astro.params;
if (!slug) {
  return Astro.redirect('/blog/', 302);
}
return Astro.redirect(`/${slug}/`, 301);
---
