---
import { footerColumns, socialLinks } from '../data/footer';
import { getAllPosts } from '../lib/posts';

const latestPosts = (await getAllPosts()).slice(0, 6);
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer-top">
    <div class="footer-brand">
      <a href="/" class="footer-logo">
        <img src="/images/brand/logo.svg" alt="Nerd Plaza" width="166" height="42" loading="lazy" />
      </a>

      <div class="footer-social" role="list" aria-label="Social media">
        {
          socialLinks.map((social) => (
            <a href={social.href} class="social-link" target="_blank" rel="noopener noreferrer" aria-label={social.label}>
              {social.icon === 'facebook' && (
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z" />
                </svg>
              )}
              {social.icon === 'instagram' && (
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z" />
                </svg>
              )}
              {social.icon === 'twitter' && (
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
                </svg>
              )}
              {social.icon === 'youtube' && (
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z" />
                </svg>
              )}
            </a>
          ))
        }
      </div>

      <p class="footer-about">
        Nerd Plaza is de plek waar passie voor gamen gedeeld wordt. Met de laatste game trends, interessante blog
        artikelen en ontelbare product reviews is dit de plek voor echte gamers.
      </p>
      <p class="footer-sitemap">
        <strong><a href="/sitemap/">Sitemap</a></strong>
      </p>
      <p class="footer-copy">© {year} All rights reserved</p>
    </div>

    <div class="footer-column">
      <p class="footer-heading">Laatste artikelen</p>
      <ul class="footer-posts">
        {
          latestPosts.map((post) => (
            <li>
              <a href={`/${post.id}/`}>{post.data.title}</a>
            </li>
          ))
        }
      </ul>
    </div>

    {
      footerColumns.map((column) => (
        <div class="footer-column">
          <p class="footer-heading">{column.title}</p>
          <ul class="footer-links">
            {column.links.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</footer>

<style>
  .footer {
    background: var(--color-bg-dark);
    padding-block: clamp(2.25rem, 5vw, 4.5rem) clamp(2rem, 4vw, 3.5rem);
  }

  .footer-top {
    display: grid;
    grid-template-columns: 1.4fr repeat(5, 1fr);
    gap: clamp(1.5rem, 3vw, 2.5rem);
  }

  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .footer-logo img {
    width: 166px;
    height: auto;
  }

  .footer-social {
    display: flex;
    gap: 1rem;
  }

  .social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    color: var(--color-accent);
    transition: transform var(--transition), color var(--transition);
  }

  .social-link:hover {
    color: var(--color-accent-hover);
    transform: translateY(-2px);
  }

  .footer-about {
    max-width: 300px;
    font-size: 0.9375rem;
    line-height: 1.7;
    color: var(--color-text-muted);
  }

  .footer-sitemap a {
    color: var(--color-text);
    transition: color var(--transition);
  }

  .footer-sitemap a:hover {
    color: var(--color-accent);
  }

  .footer-copy {
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }

  .footer-heading {
    margin-bottom: 1rem;
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-accent);
  }

  .footer-posts,
  .footer-links {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .footer-posts a,
  .footer-links a {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-text-muted);
    transition: color var(--transition);
  }

  .footer-posts a:hover,
  .footer-links a:hover {
    color: var(--color-text);
  }

  @media (max-width: 1200px) {
    .footer-top {
      grid-template-columns: repeat(3, 1fr);
    }

    .footer-brand {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 767px) {
    .footer-top {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 479px) {
    .footer-top {
      grid-template-columns: 1fr;
    }
  }
</style>
