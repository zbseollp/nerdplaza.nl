---
import { getRelatedPosts, postPubDate, postUrl } from '../lib/posts';

interface Props {
  currentSlug?: string;
  heading?: string;
}

const { currentSlug, heading = 'Andere artikelen' } = Astro.props;

const posts = await getRelatedPosts(currentSlug, 6);

function formatDate(date: Date) {
  return date.toLocaleDateString('nl-NL', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
}
---

<aside class="sidebar" aria-label="Gerelateerde artikelen">
  <h2 class="sidebar-heading">{heading}</h2>
  <ul class="sidebar-list">
    {
      posts.map((post) => (
        <li class="sidebar-item">
          <a href={postUrl(post)} class="sidebar-link">
            <span class="sidebar-link-title">{post.data.title}</span>
            <time class="sidebar-link-date" datetime={postPubDate(post).toISOString()}>
              {formatDate(postPubDate(post))}
            </time>
          </a>
        </li>
      ))
    }
  </ul>
</aside>

<style>
  .sidebar {
    position: sticky;
    top: 1.5rem;
  }

  .sidebar-heading {
    font-size: 1.125rem;
    font-weight: 600;
    margin-bottom: 1.25rem;
    color: var(--color-text);
  }

  .sidebar-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .sidebar-link {
    display: block;
    padding: 1rem;
    border-radius: var(--radius-md);
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border);
    transition: border-color var(--transition), transform var(--transition);
  }

  .sidebar-link:hover {
    border-color: var(--color-accent);
    transform: translateY(-1px);
  }

  .sidebar-link-title {
    display: block;
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.4;
    color: var(--color-text);
    margin-bottom: 0.35rem;
  }

  .sidebar-link-date {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
  }
</style>
