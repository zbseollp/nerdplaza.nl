---
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
  variant?: 'card' | 'classic';
}

const { post, variant = 'classic' } = Astro.props;
const { title, pubDate, featuredImage, imageAlt } = post.data;
const postUrl = `/${post.id}/`;

const formattedDate = pubDate.toLocaleDateString('nl-NL', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<article class:list={['blog-card', variant === 'classic' && 'blog-card--classic']}>
  {
    featuredImage && (
      <a href={postUrl} class="blog-card-thumb" tabindex="-1" aria-hidden="true">
        <img src={featuredImage} alt={imageAlt || title} width="300" height="200" loading="lazy" decoding="async" />
      </a>
    )
  }
  <div class="blog-card-body">
    <p class="blog-card-title">
      <a href={postUrl}>{title}</a>
    </p>
    <div class="blog-card-meta">
      <time datetime={pubDate.toISOString()}>{formattedDate}</time>
    </div>
    <a href={postUrl} class="blog-card-readmore" aria-label={`Lees meer over ${title}`}>
      Lees verder »
    </a>
  </div>
</article>

<style>
  .blog-card {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .blog-card--classic {
    gap: 0;
  }

  .blog-card:not(.blog-card--classic) {
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
    transition: transform var(--transition), box-shadow var(--transition), border-color var(--transition);
  }

  .blog-card:not(.blog-card--classic):hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-card);
    border-color: rgba(214, 82, 248, 0.2);
  }

  .blog-card-thumb {
    display: block;
    margin-bottom: 1rem;
    border-radius: var(--radius-sm);
    overflow: hidden;
    aspect-ratio: 16 / 10;
    background: var(--color-bg-dark);
  }

  .blog-card-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .blog-card:hover .blog-card-thumb img {
    transform: scale(1.03);
  }

  .blog-card-body {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    flex: 1;
  }

  .blog-card:not(.blog-card--classic) .blog-card-body {
    padding: 1.25rem 1.5rem 1.5rem;
  }

  .blog-card-title {
    margin: 0;
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.45;
  }

  .blog-card--classic .blog-card-title {
    font-size: 0.9375rem;
    font-weight: 400;
  }

  .blog-card-title a {
    color: var(--color-text);
    transition: color var(--transition);
  }

  .blog-card-title a:hover {
    color: var(--color-accent);
  }

  .blog-card-meta {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
  }

  .blog-card-readmore {
    margin-top: auto;
    font-size: 0.8125rem;
    color: var(--color-accent);
    text-decoration: none;
    transition: color var(--transition);
  }

  .blog-card-readmore:hover {
    color: var(--color-accent-hover);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
</style>
