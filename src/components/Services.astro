---
import { categoryCards } from '../data/categories';
---

<section class="services section">
  <div class="container">
    <div class="services-header">
      <h2 class="section-heading">Laatste Product Reviews</h2>
      <p class="section-subtitle">Bekijk hier onze laatste product vergelijkingen.</p>
    </div>

    <div class="services-grid">
      {
        categoryCards.map((category) => (
          <article class="service-card">
            <div class="service-card-image">
              <img src={category.image} alt={category.imageAlt} width="275" height="183" loading="lazy" decoding="async" />
            </div>
            <div class="service-card-body">
              <h3>{category.title}</h3>
              <ul class="service-links">
                {category.links.map((link) => (
                  <li>
                    <a href={link.href}>{link.label}</a>
                  </li>
                ))}
              </ul>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .services-header {
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1.25rem, 2.5vw, 2rem);
  }

  .service-card {
    display: flex;
    flex-direction: column;
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
    transition: transform var(--transition), box-shadow var(--transition), border-color var(--transition);
  }

  .service-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-card);
    border-color: rgba(214, 82, 248, 0.25);
  }

  .service-card-image {
    aspect-ratio: 3 / 2;
    overflow: hidden;
    background: var(--color-bg-dark);
  }

  .service-card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .service-card:hover .service-card-image img {
    transform: scale(1.04);
  }

  .service-card-body {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.25rem 1.5rem 1.5rem;
  }

  .service-card-body h3 {
    color: var(--color-text);
  }

  .service-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem 0.75rem;
  }

  .service-links a {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    transition: color var(--transition);
  }

  .service-links a:hover {
    color: var(--color-accent);
  }

  @media (max-width: 1023px) {
    .services-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 599px) {
    .services-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
