---
interface Props {
  title?: string;
  subtitle?: string;
  imageSrc?: string;
  imageAlt?: string;
}

const {
  title = 'Nerd Plaza: Alles wat jij nodig om te gamen',
  subtitle = 'Bij Nerd Plaza draait alles om gamen. Van de leukste games tot de beste game PC\'s. Ben jij benieuwd naar wat Nerd Plaza voor jou kan betekenen? Neem snel een kijkje op onze pagina!',
  imageSrc = '/images/brand/hero-illustration.svg',
  imageAlt = 'Gaming illustratie Nerd Plaza',
} = Astro.props;
---

<section class="hero section">
  <div class="container hero-grid">
    <div class="hero-content">
      <h1>{title}</h1>
      <p class="hero-text">{subtitle}</p>
    </div>
    <div class="hero-visual">
      <img src={imageSrc} alt={imageAlt} width="570" height="577" loading="eager" decoding="async" />
    </div>
  </div>
</section>

<style>
  .hero {
    padding-bottom: clamp(6rem, 12vw, 7.5rem);
    background: var(--color-bg);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: clamp(2rem, 5vw, 4rem);
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .hero-text {
    max-width: 34rem;
    color: var(--color-text-muted);
    font-size: clamp(1rem, 1.5vw, 1.125rem);
  }

  .hero-visual {
    display: flex;
    justify-content: center;
    align-items: flex-end;
  }

  .hero-visual img {
    width: min(100%, 570px);
    filter: drop-shadow(0 20px 40px rgba(0, 0, 0, 0.25));
    animation: float 6s ease-in-out infinite;
  }

  @keyframes float {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-8px);
    }
  }

  @media (max-width: 767px) {
    .hero-grid {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .hero-content {
      align-items: center;
    }

    .hero-visual img {
      width: min(70%, 320px);
    }
  }
</style>
